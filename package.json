{
  "name": "cs2-manager",
  "version": "1.1.5",
  "description": "SSIM – Santer Steam Inventory Manager (multi-tenant CS2 inventory, trading & market tool)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:protected": "tsc -p tsconfig.build.json && node build/pack.js",
    "pack": "npm run build:protected",
    "build:tauri": "node build/make-tauri.js",
    "release-zip": "node build/release-zip.js",
    "release": "tsc -p tsconfig.build.json && node build/pack.js && node build/release-zip.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --exec ts-node src/index.ts --ext ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.22.2",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^5.0.1",
    "node-machine-id": "^1.1.12",
    "socks-proxy-agent": "^6.2.1",
    "steam-totp": "^2.1.2",
    "steam-tradeoffer-manager": "^2.13.0",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@yao-pkg/pkg": "^6.1.1",
    "bytenode": "^1.5.7",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.0.2",
    "rcedit": "^5.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "pkg": {
    "targets": [
      "node24-win-x64"
    ],
    "assets": [
      "public/**/*",
      "node_modules/steam-user/**/*",
      "node_modules/steamcommunity/**/*",
      "node_modules/steam-tradeoffer-manager/**/*",
      "node_modules/@doctormckay/**/*",
      "node_modules/lzma/**/*",
      "node_modules/**/*.pem",
      "node_modules/**/*.proto"
    ],
    "outputPath": "."
  }
}
