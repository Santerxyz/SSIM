{
  "name": "ssim",
  "version": "1.5.1",
  "description": "SSIM – Santer Steam Inventory Manager (multi-tenant CS2 inventory, trading & market tool)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "build:protected": "tsc -p tsconfig.build.json && node build/pack.js",
    "pack": "npm run build:protected",
    "build:tauri": "node build/make-tauri.js",
    "release": "npm run build:tauri",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --exec ts-node src/index.ts --ext ts",
    "test": "node --require ts-node/register/transpile-only --require ./test/_setup.cjs --test \"test/**/*.test.ts\"",
    "sign-release": "node build/sign-update.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.22.2",
    "fs-extra": "^11.2.0",
    "globaloffensive": "^3.3.0",
    "https-proxy-agent": "^5.0.1",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^6.2.1",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.2",
    "steam-tradeoffer-manager": "^2.13.0",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "@yao-pkg/pkg": "^6.1.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "assets": [
      "public/**/*",
      "node_modules/steam-user/**/*",
      "node_modules/steamcommunity/**/*",
      "node_modules/steam-tradeoffer-manager/**/*",
      "node_modules/globaloffensive/**/*",
      "node_modules/steam-session/**/*",
      "node_modules/qrcode/**/*",
      "node_modules/@doctormckay/**/*",
      "node_modules/lzma/**/*",
      "node_modules/**/*.pem"
    ],
    "outputPath": "."
  }
}
