{
  "compilerOptions": {
    "target":                        "ES2020",
    "module":                        "commonjs",
    "lib":                           ["ES2020"],
    "outDir":                        "./dist",
    "rootDir":                       "./src",
    "strict":                        true,
    "noEmitOnError":                 true,
    "esModuleInterop":               true,
    "resolveJsonModule":             true,
    "declaration":                   true,
    "declarationMap":                true,
    "sourceMap":                     true,
    "skipLibCheck":                  true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny":                 true,
    "strictNullChecks":              true,
    "noUnusedLocals":                false,
    "noUnusedParameters":            false
  },
  "include":  ["src/**/*"],
  "exclude":  ["node_modules", "dist"]
}
