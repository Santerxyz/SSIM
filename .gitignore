# ============================================================================
#  SSIM .gitignore — defense-in-depth.
#  Sensitive dirs are excluded WHOLESALE (not file-by-file) so that any NEW
#  secret/user-data file dropped into them stays out of history automatically.
#  NEVER relax these: vault.enc, accounts.json, refresh tokens, mafiles, and
#  license seats are real credentials for a live 250+ account fleet.
# ============================================================================

# --- Dependencies & compiled output ---------------------------------------
node_modules/
dist/
dist-tauri/

# --- SENSITIVE: user data & secrets (NEVER commit, whole directories) ------
Vault/
data/
mafiles/
secrets.local.bat
*.maFile
*.mafile
read-vault.js

# --- Licensing: local seat key + signed token (machine-bound) --------------
*.key
*.token
license.token.json
license.meta.json

# --- Packaged binaries & release artifacts (huge / not source) -------------
*.exe
release/
release-tauri/

# --- Rust / Tauri build output (generated, large) --------------------------
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/

# --- Embedded-backend self-extraction (generated at runtime / dev run) ------
runtime/
.backend-stamp
.ssim-selftest.out

# --- Logs & atomic-write artifacts (may contain credentials) ---------------
logs/
*.log
*.bak
*.tmp
*.tmp.*

# --- Stray OS/tooling folders ----------------------------------------------
Microsoft/

# --- Frontend UI-pass dev/QA artifacts (NOT shipped; safe to delete) --------
_sg_server.cjs
public/_ssim_styleguide.html
.shot_*.png
.sg_*.png

# --- Working scratch: session prompts, analysis reports, planning docs -------
#  (AI/handoff prompts + investigation write-ups; NOT source, kept out of history)
*_PROMPT*.md
*_fable5.md
*_opus48*.md
DEEPTHINK_*.md
HANDOFF_*.md
SESSION_HANDOFF_*.md
MASTERPIECE_PLAN.md
PROJECT_MAP.md
PROXY_RULES_IMPLEMENTATION_REPORT.md
RATELIMIT_ROOT_CAUSE_*.md
/Version 1.4.1/
/hardening/
